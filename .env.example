# الإعدادات دي بتتحط في Vercel ← Settings ← Environment Variables (مش في ملف)

# إجباري: مفتاح Groq من console.groq.com
GROQ_API_KEY=

# اختياري: رابط موقعك (لجوجل وتوقيع المشاركة). لو فاضي بيستخدم رابط Vercel
NEXT_PUBLIC_SITE_URL=

# اختياري: موديل «متوازن» لو عايز تغيّره من غير ما تعدّل الكود
GROQ_MODEL=

# اختياري: طبقة احتياطية إضافية من OpenRouter (openrouter.ai) خلف نفس الواجهة العربية.
# لو حطيت المفتاح ده، الموقع بيجرب موديلات OpenRouter المجانية تلقائياً لو Groq كله مشغول
# أو موديلاته اتقفلت — المستخدم مش هيحس بأي فرق، كله بيفضل عربي زي ما هو.
# راجع قايمة الموديلات المجانية الحالية في lib/models.js (OPENROUTER_FALLBACK_IDS) قبل التفعيل.
OPENROUTER_API_KEY=
